# Settings template for torrent_updater. Copy to .env and fill in your values:
#   cp .env.example .env
# The .env file is gitignored — real addresses/passwords never reach git.

# === Rutracker (required) ===
LOGIN_RUTRACKER=<rutracker login>
PASSWORD_RUTRACKER=<rutracker password>

# === Transmission (required) ===
TR_HOST=<transmission host>          # e.g. the host address on your LAN
TR_PORT=9091
TR_USER=<transmission user>
TR_PASSWORD=<transmission password>

# === Paths ===
DOWNLOAD_DIR=<path to download directory>

# === Network addresses (internal IPs live only in .env, which is gitignored) ===
HOME_DNS=<router dns ip>             # used in docker-compose.yml: dns: ${HOME_DNS}
JELLYFIN_URL=<jellyfin url>          # e.g. http://<ip>:8096
LE_ZAL_HOST=<kodi le-zal ip>         # LE-zal set-top box address (reference, see AGENTS.md)

# === Schedule (optional, defaults are in docker-compose.yml) ===
CHECK_INTERVAL=1
CHECK_INTERVAL_UNIT=hours
RUN_ON_STARTUP=true

# === Rutracker cookies against captcha (optional) ===
# RUTRACKER_BB_SESSION=<bb_session value>
# RUTRACKER_BB_DATA=<bb_data value>
# RUTRACKER_CF_CLEARANCE=<cf_clearance value>

# === Telegram (optional; notifications are commented out in code) ===
# TELEGRAM_BOT_TOKEN=<token>
# TELEGRAM_CHAT_ID=<chat id>

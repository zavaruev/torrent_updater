# Шаблон настроек torrent_updater. Скопируйте в .env и заполните своими
# значениями: cp .env.example .env
# Файл .env находится в .gitignore — реальные адреса/пароли в git не попадают.

# === Rutracker (обязательно) ===
LOGIN_RUTRACKER=<логин rutracker>
PASSWORD_RUTRACKER=<пароль rutracker>

# === Transmission (обязательно) ===
TR_HOST=<ip transmission>            # например адрес хоста в локальной сети
TR_PORT=9091
TR_USER=<пользователь transmission>
TR_PASSWORD=<пароль transmission>

# === Пути ===
DOWNLOAD_DIR=<путь к каталогу загрузок>

# === Сетевые адреса (внутренние IP — только здесь, в .git) ===
HOME_DNS=<ip dns-роутера>            # используется в docker-compose.yml: dns: ${HOME_DNS}
JELLYFIN_URL=<url jellyfin>          # например http://<ip>:8096
LE_ZAL_HOST=<ip kodi le-zal>         # адрес приставки LE-zal (справочно, см. AGENTS.md)

# === Расписание (опционально, есть дефолты в docker-compose.yml) ===
CHECK_INTERVAL=1
CHECK_INTERVAL_UNIT=hours
RUN_ON_STARTUP=true

# === Куки Rutracker против капчи (опционально) ===
# RUTRACKER_BB_SESSION=<значение bb_session>
# RUTRACKER_BB_DATA=<значение bb_data>
# RUTRACKER_CF_CLEARANCE=<значение cf_clearance>

# === Telegram (опционально; уведомления закомментированы в коде) ===
# TELEGRAM_BOT_TOKEN=<токен>
# TELEGRAM_CHAT_ID=<id чата>
